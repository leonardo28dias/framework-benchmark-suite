data/processed/*
!data/processed/.gitkeep
catalog/datasets/*
!catalog/datasets/.gitkeep
catalog/*.csv
manifests/*.yaml
exports/*
!exports/.gitkeep
collections/*.yaml
!collections/sample_collection.yaml